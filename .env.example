# ─── Banco de dados ──────────────────────────────────────────────────────────
DB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>"
DB_URL_TEST="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>-test"

# ─── Aplicação ───────────────────────────────────────────────────────────────
APP_PORT=5011
NODE_ENV=development          # development | production | test
DEBUGLOG=true                 # Loga as rotas acessadas no console

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere secrets fortes com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_ACCESS_TOKEN=<secret-forte-aqui>
JWT_SECRET_REFRESH_TOKEN=<secret-forte-aqui>
JWT_SECRET_PASSWORD_RECOVERY=<secret-forte-aqui>
JWT_ACCESS_TOKEN_EXPIRATION="1d"
JWT_REFRESH_TOKEN_EXPIRATION="7d"
JWT_PASSWORD_RECOVERY_EXPIRATION="30m"

# ─── Email (MailerSend — envio pela API HTTP) ────────────────────────────────
# O envio usa https://api.mailersend.com na porta 443. Nao use SMTP: o plano
# free do Render bloqueia trafego de saida nas portas 25, 465 e 587.
# Token: Integrations → MailerSend API → Manage → Create new token
# Atenção: sem data de expiração, o token expira em 24h
MAILERSEND_API_KEY="mlsn.<seu-token-aqui>"
MAILERSEND_FROM_EMAIL="no-reply@<seu-dominio>.mlsender.net"  # precisa ser de um domínio verificado
MAILERSEND_FROM_NAME="LevelUp English"
DISABLED_EMAIL=false                  # true para desativar envio (útil em testes)
ADMIN_EMAIL="seu-email@gmail.com"     # Recebe notificações de erro do servidor

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"  # Usado no link de reset de senha enviado por e-mail
# Opcional: URL base exibida no Swagger. Sem ela, usa http://localhost:$APP_PORT
# SWAGGER_SERVER_URL="https://level-up-english-api.onrender.com"

# ─── MongoDB (opcional — possuem valores padrão internos) ─────────────────────
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_MAX_POOL_SIZE=10

# ─── Logger (opcional — possuem valores padrão internos) ──────────────────────
# LOG_ENABLED=true
# LOG_LEVEL=info                      # error | warn | info | verbose | debug
# LOG_MAX_SIZE_GB=1
